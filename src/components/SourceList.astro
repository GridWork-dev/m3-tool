---
import type { Source } from '../data/schemas.ts'
import { citationView } from '../lib/citations.ts'
import Tier from './Tier.astro'

interface Props {
  sources: readonly Source[]
  list: string
}
const { sources, list } = Astro.props
---
<ol class="srcs" data-sources data-source-list={list}>{sources.map((source,i)=>{const s=citationView(source); return <li data-source-index={i}><Tier tier={s.tier}/><div><span class="publisher">{s.publisher}</span> · {s.href ? <a href={s.href}>{s.title}</a> : <span>{s.title}</span>}<span class="accessed">Accessed <time datetime={s.accessed}>{s.accessed}</time></span>{s.note && <details><summary>Source note</summary><p>{s.note}</p></details>}</div></li>})}</ol>
<style>.srcs { margin:var(--s-5) 0 0; padding:var(--s-3) 0 0; border-top:1px solid var(--line); list-style:none; color:var(--muted); font-size:var(--fs-xs); } li { display:flex; align-items:baseline; gap:var(--s-2); margin:var(--s-2) 0; overflow-wrap:anywhere; } .publisher { color:var(--text); } .accessed { display:block; color:var(--dim); margin-top:var(--s-1); } summary { display:flex; align-items:center; min-height:44px; cursor:pointer; color:var(--muted); } p { margin:0 0 var(--s-3); } a { display:inline-flex; align-items:center; min-height:44px; text-decoration:underline; text-underline-offset:3px; }</style>
