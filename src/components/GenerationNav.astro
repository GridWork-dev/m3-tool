---
import { GENERATION_SECTIONS, type GenerationSection } from '../lib/routes.ts'

interface Props {
  gen: string
  current: GenerationSection['key']
}
const { gen, current } = Astro.props
---

<nav aria-label="Generation">
  <ul>
    {
      GENERATION_SECTIONS.map((s) => (
        <li>
          <a href={s.path(gen)} aria-current={s.key === current ? 'page' : undefined}>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0 0 var(--s-6);
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  a {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: var(--s-3) var(--s-4);
    color: var(--muted);
    text-decoration: none;
  }
  a[aria-current] {
    color: var(--board);
    box-shadow: inset 0 -2px var(--board);
  }
</style>
