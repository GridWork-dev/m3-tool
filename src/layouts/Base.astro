---
import { Font } from 'astro:assets'
import SiteFooter from '../components/SiteFooter.astro'
import SiteNav from '../components/SiteNav.astro'
import { pageTitle } from '../lib/site.ts'
import '../styles/global.css'

interface Props {
  title?: string | undefined
  description?: string | undefined
}

const { title, description } = Astro.props
// The site stays out of search results until the public beta sets PUBLIC_INDEXABLE=true.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle(title)}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="sr skip" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line bg-floor-deep text-muted text-(length:--fs-xs)">
      <div class="wrap pt-7 pb-8">
        <SiteFooter />
      </div>
    </footer>
  </body>
</html>

<style>
  /* Hidden until it takes focus (.sr, from global.css, clips it to nothing). Unlayered, so these
     rules beat the base-layer .sr. */
  .skip:focus {
    position: fixed;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
    min-height: 44px;
    padding: 0 var(--s-4);
    overflow: visible;
    clip: auto;
    white-space: normal;
    background: var(--board);
    color: var(--board-ink);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--r-sm);
  }
</style>
