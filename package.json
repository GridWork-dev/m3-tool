{
  "name": "m3-tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "astro sync && node node_modules/typescript-7/bin/tsc --noEmit && astro check",
    "test": "vitest run",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "check:links": "node tools/check-links.ts dist",
    "check:data": "node tools/check-data.ts data",
    "validate-asset": "node tools/validate-asset.ts",
    "check:site": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:data && pnpm build && pnpm check:links",
    "check:pipeline": "cd pipeline && uv run ruff check && uv run ruff format --check && uv run pyright && uv run pytest",
    "check": "pnpm check:site && pnpm check:pipeline",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.8",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "gltf-validator": "2.0.0-dev.3.10",
    "ktx-parse": "2.0.0",
    "meshoptimizer": "1.3.0",
    "pagefind": "1.6.0",
    "parse5": "8.1.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.167.0",
    "yaml": "2.9.1"
  }
}
