#!/bin/sh
# Scan the commits this push sends, and no others, for secrets.
#
# Git feeds one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# $1 is the remote's name. `gitleaks` needs to be on PATH (`mise install`). Never bypass this hook.
#
#   remote ref exists   scan <remote sha>..<local sha>
#   new remote ref      scan <local sha> --not --remotes=<remote name>
#   deletion            skip: nothing is sent

remote="$1"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not on PATH; run 'mise install'" >&2
  exit 1
fi

# An all-zero sha (40 digits, or 64 for SHA-256 repos) means "no such object".
is_zero() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  is_zero "$local_sha" && continue

  if is_zero "$remote_sha" || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # A new branch or tag, or a remote sha this clone has never fetched: scan everything the
    # remote does not already have.
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi

  gitleaks git --redact --log-opts="$range" || status=1
done

exit "$status"
